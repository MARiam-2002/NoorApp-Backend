{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }],
  "functions": {
    "api/index.js": {
      "includeFiles": "prisma/migrations/**,prisma/schema.prisma,assets/**,src/shared/data/**,dist/shared/data/**"
    }
  }
}
