# Required — copy to .env for local dev, or set in Vercel Dashboard for production
# On Vercel/Neon use the POOLED connection string (ends with -pooler.neon.tech)

DATABASE_URL=postgresql://user:password@host:5432/noor?sslmode=require
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=90d

# Optional
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
PORT=3000

# Password-reset email
# auto = Resend if RESEND_API_KEY is set, otherwise SMTP
# smtp  = Brevo (or other SMTP) even if a Resend key exists
# resend = Resend only
EMAIL_PROVIDER=smtp

# Local: keep false to mock. Production/staging: treated as enabled automatically
# when RESEND_API_KEY or SMTP credentials are present.
MAIL_ENABLED=true

# --- Brevo Free SMTP (recommended when you have no custom domain budget) ---
# Host/port are public constants, not secrets.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false

# Settings → SMTP & API → SMTP
# MAIL_USER = Login (looks like xxx@smtp-brevo.com). Never use smtp-relay.brevo.com here.
# MAIL_PASSWORD = SMTP key (generate in the same page). Never the Brevo account password.
MAIL_USER=
MAIL_PASSWORD=

# Settings → Senders, Domains & IPs → Add a sender → verify with the 6-digit code
# emailed to that inbox. Unverified From addresses are rejected.
# Do NOT put the SMTP login (@smtp-brevo.com) in MAIL_FROM.
# Free Gmail/Outlook/Yahoo can be OTP-verified as a sender; those domains cannot
# be authenticated (no DKIM), so inbox providers may still spam-folder or reject.
MAIL_FROM=

# --- Resend (optional alternative; needs a domain you verified at resend.com/domains) ---
RESEND_API_KEY=

RESET_PASSWORD_DEEPLINK=noorapp://auth/reset-password?token={{token}}



EMAIL_PROVIDER=smtp

MAIL_ENABLED=true

MAIL_HOST=smtp-relay.brevo.com

MAIL_PORT=587

MAIL_SECURE=false

MAIL_USER=<انسخي Login من Brevo SMTP & API>

MAIL_PASSWORD=<انسخي SMTP Key من Brevo>

MAIL_FROM=Noor <الإيميل اللي عملتيله Verify في Brevo>

RESEND_API_KEY=

RESET_PASSWORD_DEEPLINK=noorapp://auth/reset-password?token={{token}}
# --- Quran Foundation Content API (optional but recommended) ---
# Create a Backend app at https://developer.quran.foundation
# Without these, public Content API v4 (api.quran.com) is used as fallback.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# production | prelive
QF_ENV=production

# --- Firebase Cloud Messaging (required for Azan push backup + general push) ---
# Option A: paste the full service-account JSON as one line
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: split fields (PRIVATE_KEY use \n for newlines)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Protects /api/v1/cron/prayer-reminders (also accepts Vercel Cron header)
CRON_SECRET=
