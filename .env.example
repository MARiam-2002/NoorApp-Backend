# Noor API — Environment Variables
# Copy to `.env` for local development.
# On Railway: set these in the service Variables UI (never commit real secrets).

# =============================================================================
# Required
# =============================================================================

# Neon PostgreSQL pooled connection string (recommended for serverless/containers)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# JWT (min 32 characters each — generate strong random values)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=90d

# =============================================================================
# Runtime / Railway
# =============================================================================

NODE_ENV=production
# Railway injects PORT automatically — do not hardcode in production
PORT=3000
# Bind address (Railway/containers need 0.0.0.0)
HOST=0.0.0.0

# Public HTTPS origin of THIS API (no trailing slash). Used for absolute media URLs
# when Host headers are unavailable.
# Production: https://noorapp-backend-production.up.railway.app
PUBLIC_APP_ORIGIN=

# Comma-separated CORS allow-list (Flutter web / admin origins)
CORS_ORIGIN=https://your-frontend.example.com,http://localhost:3000

# Global API limiter: per Bearer token (or IP if anonymous). Auth routes stay stricter.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
LOG_LEVEL=info
SWAGGER_ENABLED=true

# =============================================================================
# Redis (Railway Redis / Key Value) — optional
# =============================================================================
# Current API cache defaults to in-memory. Set CACHE_PROVIDER=redis only when
# a Redis-backed cache implementation is wired. Always set REDIS_URL from Railway.
CACHE_PROVIDER=memory
REDIS_URL=

# =============================================================================
# Email (password reset) — Brevo SMTP or Resend
# =============================================================================

# auto | smtp | resend
# Railway Free/Trial/Hobby require HTTPS mail; use a Brevo API key, NOT an SMTP key.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_ENABLED=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
RESEND_API_KEY=
RESET_PASSWORD_DEEPLINK=noorapp://auth/reset-password?token={{token}}

# =============================================================================
# Storage (optional — local / S3 / cloudinary enum)
# =============================================================================
# Cloudinary is listed as a STORAGE_PROVIDER option; dedicated CLOUDINARY_*
# credentials are not required by the current runtime unless you wire them.

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_LOCAL_PUBLIC_URL=

# =============================================================================
# OAuth Google (optional)
# =============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_SERVER_CLIENT_ID=770958562307-d3o03m06eqkk5urlla6qarr2uuv345r8.apps.googleusercontent.com

# =============================================================================
# Quran Foundation Content API (optional — falls back to api.quran.com)
# =============================================================================

QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=production

# =============================================================================
# Firebase Cloud Messaging (Azan / push backup)
# =============================================================================

FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =============================================================================
# Cron (Railway Cron Job or GitHub Actions → HTTP endpoint)
# =============================================================================
# Protects POST/GET /api/v1/cron/prayer-reminders
CRON_SECRET=
# In-process per-minute reminder scheduler (Azan, Salawat, Mulk, Duha, Qiyam, Khatmah).
# auto = on only when NODE_ENV=production. The Railway cron above stays as a safety net.
REMINDER_SCHEDULER_ENABLED=auto

# =============================================================================
# Noor AI (Phase 1 foundation — OFF by default, all optional)
# =============================================================================
# With AI_ENABLED=false every /api/v1/ai/* route returns 503 AI_DISABLED.
# Invalid or empty values fall back to the defaults below (never block boot).
# Model ids are configured here only — never hard-coded in code.
AI_ENABLED=false
AI_PROVIDER=openai
AI_FAST_MODEL=
AI_REASONING_MODEL=
AI_EMBEDDING_MODEL=
AI_MAX_MESSAGE_LENGTH=1500
AI_DAILY_MESSAGE_LIMIT=20
AI_MAX_STREAM_SECONDS=120

# =============================================================================
# Public legal pages — /privacy, /terms and /delete-account (Google Play URLs)
# =============================================================================
# Empty values render as [PLACEHOLDER] on the public pages.
# Legal pages (/privacy, /terms, /delete-account): complete before public release.
# Use the exact operator/developer identity shown on your Google Play listing.
LEGAL_DEVELOPER_NAME=
# A monitored email accepting privacy, support, and Google-account deletion requests.
LEGAL_CONTACT_EMAIL=
# Actual country of the operator; do not use the user's location.
LEGAL_COUNTRY=
# Official public website (HTTPS); update if you later move to a custom domain.
LEGAL_WEBSITE=https://noor-daily-companion.kimberlysmithv894339.chatgpt.site
# Live Zakat metal quotes: key stays on Railway/backend ONLY (never Flutter).
# Provider documentation: https://metals.dev/docs
# Select a subscription quota suitable for runtime traffic and replica count.
# 900s shared snapshot cache: approximately 2,976 requests / 31 days / busy replica.
# Restarts and upstream failures can increase requests. Free quota is not sufficient for continuous use.
METALS_DEV_API_KEY=
METALS_CACHE_TTL_SECONDS=900
METALS_MAX_AGE_SECONDS=1800
METALS_REQUEST_TIMEOUT_MS=8000
# Keep false in production. True only allows explicitly unverified legacy manual inputs.
ZAKAT_ALLOW_MANUAL_PRICES=false

# Verified, licensed and externally reviewed full Warsh bundle; never put Hafs here.
NOOR_WARSH_BUNDLE_PATH=
NOOR_WARSH_BUNDLE_SHA256=

# Set true only after Warsh text permission and corpus review are documented.
WARSH_TEXT_APPROVED=false
