generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                 @id @default(uuid())
  username                String                 @unique(map: "users_username_unique")
  email                   String                 @unique
  password                String?
  provider                AuthProvider           @default(LOCAL)
  providerId              String?
  role                    UserRole               @default(USER)
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  points                  Int                    @default(0)
  timezone                String                 @default("Africa/Cairo")
  latitude                Float?
  longitude               Float?
  googleId                String?                @unique
  fullName                String?
  quranFontSize           Int                    @default(28)
  quranReciter            String                 @default("Mishary_Alafasy")
  quranTafsir             String                 @default("Ibn_Kathir")
  quranTranslation        String                 @default("Sahih_International")
  quranAutoScrollEnabled  Boolean                @default(false)
  avatarUrl               String?
  phone                   String?
  city                    String?
  country                 String?
  level                   Int                    @default(1)
  prayerCalculationMethod String                 @default("EGYPTIAN_GENERAL_AUTHORITY_OF_SURVEY")
  challengeCompletions    ChallengeCompletion[]
  dailyDhikrCompletions   DailyDhikrCompletion[]
  dailyProgress           DailyProgress[]
  khatmah                 Khatmah?
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  prayerCompletions       PrayerCompletion[]
  quranBookmarks          QuranBookmark[]
  quranLastRead           QuranLastRead?
  quranReadingHistory     QuranReadingHistory[]
  refreshTokens           RefreshToken[]
  tasbihLogs              TasbihLog[]
  tasbihResetHistory      TasbihResetHistory[]
  adhkarFavorites         AdhkarFavorite[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model DailyProgress {
  id                       String   @id @default(uuid())
  userId                   String
  date                     DateTime @db.Date
  quranPagesRead           Int      @default(0)
  adhkarCompleted          Boolean  @default(false)
  morningAdhkarCompleted   Boolean  @default(false)
  eveningAdhkarCompleted   Boolean  @default(false)
  sadaqahAmount            Decimal  @default(0) @db.Decimal(10, 2)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_progress")
}

model PrayerCompletion {
  id          String     @id @default(uuid())
  userId      String
  date        DateTime   @db.Date
  prayer      PrayerName
  completedAt DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, prayer])
  @@index([userId, date])
  @@map("prayer_completions")
}

model Surah {
  id             Int             @id
  nameEn         String
  nameAr         String
  totalPages     Int             @default(0)
  totalAyahs     Int             @default(0)
  revelationType RevelationType?
  ayahs          Ayah[]
  khatmahs       Khatmah[]
  bookmarks      QuranBookmark[]
  lastReads      QuranLastRead[]
  versesOfTheDay VerseOfTheDay[]

  @@map("surahs")
}

model Ayah {
  id         String @id @default(uuid())
  surahId    Int
  ayahNumber Int
  textAr     String
  page       Int?
  juz        Int?
  surah      Surah  @relation(fields: [surahId], references: [id], onDelete: Cascade)

  @@unique([surahId, ayahNumber])
  @@index([surahId])
  @@map("ayahs")
}

model Khatmah {
  id             String   @id @default(uuid())
  userId         String   @unique
  currentSurahId Int      @default(2)
  currentPage    Int      @default(1)
  totalPagesRead Int      @default(0)
  startedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  currentSurah   Surah    @relation(fields: [currentSurahId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("khatmah")
}

model QuranBookmark {
  id         String   @id @default(uuid())
  userId     String
  surahId    Int
  ayahNumber Int?
  note       String?
  createdAt  DateTime @default(now())
  page       Int?
  surah      Surah    @relation(fields: [surahId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, surahId, ayahNumber])
  @@index([userId, page])
  @@map("quran_bookmarks")
}

model QuranLastRead {
  userId     String   @id
  surahId    Int
  ayahNumber Int
  page       Int?
  updatedAt  DateTime @updatedAt
  surah      Surah    @relation(fields: [surahId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quran_last_read")
}

model QuranReadingHistory {
  id       String   @id @default(uuid())
  userId   String
  surahId  Int
  ayahFrom Int
  ayahTo   Int
  readAt   DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("quran_reading_history")
}

model VerseOfTheDay {
  id          String @id @default(uuid())
  dayOfYear   Int    @unique
  surahNumber Int
  ayahNumber  Int
  textAr      String
  referenceAr String
  surah       Surah  @relation(fields: [surahNumber], references: [id])

  @@map("verses_of_the_day")
}

model HadithOfTheDay {
  id        String @id @default(uuid())
  dayOfYear Int    @unique
  textAr    String
  sourceAr  String

  @@map("hadiths_of_the_day")
}

model DailyChallengeTemplate {
  id            String        @id @default(uuid())
  dayOfYear     Int           @unique
  titleAr       String
  titleEn       String?
  descriptionAr String
  descriptionEn String?
  type          ChallengeType
  targetValue   Int
  rewardPoints  Int           @default(50)

  @@map("daily_challenge_templates")
}

model ChallengeCompletion {
  id          String    @id @default(uuid())
  userId      String
  dayOfYear   Int
  completedAt DateTime  @default(now())
  claimedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfYear])
  @@index([userId, dayOfYear])
  @@map("challenge_completions")
}

model TasbihLog {
  id           String               @id @default(uuid())
  userId       String
  date         DateTime             @db.Date
  dhikr        TasbihDhikr          @default(ALHAMDULILLAH)
  count        Int                  @default(0)
  totalAllTime Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resetHistory TasbihResetHistory[]

  @@unique([userId, date])
  @@index([userId, date])
  @@map("tasbih_logs")
}

model TasbihResetHistory {
  id               String    @id @default(uuid())
  userId           String
  tasbihLogId      String
  countBeforeReset Int
  date             DateTime  @default(now())
  tasbihLog        TasbihLog @relation(fields: [tasbihLogId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("tasbih_reset_history")
}

model DhikrCategory {
  id            String                 @id @default(uuid())
  key           DhikrCategoryKey       @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  iconCode      String
  sortOrder     Int                    @default(0)
  totalItems    Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  completions   DailyDhikrCompletion[]
  items         DhikrItem[]

  @@index([sortOrder])
  @@map("dhikr_categories")
}

model DhikrItem {
  id              String        @id @default(uuid())
  categoryId      String
  orderInCategory Int           @default(0)
  textAr          String
  textEn          String?
  textArPlain     String?
  repeatCount     Int           @default(1)
  referenceAr     String?
  referenceEn     String?
  sourceUrl       String?
  benefitAr       String?
  benefitEn       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category    DhikrCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  completions DailyDhikrCompletion[]
  favorites   AdhkarFavorite[]

  @@index([categoryId, orderInCategory])
  @@map("dhikr_items")
}

model DailyDhikrCompletion {
  id         String         @id @default(uuid())
  userId     String
  date       DateTime       @db.Date
  categoryId String?
  itemId     String?
  countDone  Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category DhikrCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  item     DhikrItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([userId, date, categoryId, itemId])
  @@index([userId, date])
  @@map("daily_dhikr_completions")
}

model AdhkarFavorite {
  id        String    @id @default(uuid())
  userId    String
  itemId    String
  createdAt DateTime  @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item DhikrItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("adhkar_favorites")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  titleAr   String
  titleEn   String
  bodyAr    String
  bodyEn    String
  type      NotificationType @default(SYSTEM)
  readAt    DateTime?
  deepLink  String?
  payload   Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserRole {
  USER
  ADMIN
}

enum PrayerName {
  FAJR
  DHUHR
  ASR
  MAGHRIB
  ISHA
}

enum ChallengeType {
  QURAN_PAGES
  PRAYER
  PRAYERS_ALL
  ADHKAR
  SADAQAH
}

enum RevelationType {
  MAKKI
  MADANI
}

enum TasbihDhikr {
  SUBHAN_ALLAH
  ALHAMDULILLAH
  LA_ILAHA_ILLA_ALLAH
  ALLAHU_AKBAR
  ASTAGHFIRULLAH
  LA_HAWLA_WA_LA_QUWWATA_ILLA_BILLAH
}

enum DhikrCategoryKey {
  MORNING
  EVENING
  BEFORE_SLEEP
  ENTERING_MOSQUE
  AFTER_PRAYER
  GENERAL_WIRD
  TRAVEL
  SICK
  FOOD
  ISTIKHARA
  WUDU
  ISTIGHFAR
  QAYN
  MASJID_AFTER_SALAM
}

enum NotificationType {
  SYSTEM
  AZAN
  CHALLENGE
  PRAYER_REMINDER
  ACHIEVEMENT
  GENERAL
}
