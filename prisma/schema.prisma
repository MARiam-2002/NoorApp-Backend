generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                 @id @default(uuid())
  username                String                 @unique(map: "users_username_unique")
  email                   String                 @unique
  password                String?
  provider                AuthProvider           @default(LOCAL)
  providerId              String?
  role                    UserRole               @default(USER)
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  points                  Int                    @default(0)
  timezone                String                 @default("Africa/Cairo")
  latitude                Float?
  longitude               Float?
  googleId                String?                @unique
  fullName                String?
  quranFontSize           Int                    @default(28)
  quranReciter            String                 @default("Mishary_Alafasy")
  quranTafsir             String                 @default("Ibn_Kathir")
  quranTranslation        String                 @default("Sahih_International")
  quranAutoScrollEnabled  Boolean                @default(false)
  avatarUrl               String?
  phone                   String?
  city                    String?
  country                 String?
  level                   Int                    @default(1)
  prayerCalculationMethod String                 @default("EGYPTIAN_GENERAL_AUTHORITY_OF_SURVEY")
  /// Synced Azan settings across devices (see AZAN_FEATURE.md §6).
  azanPreferences         Json?
  /// FCM "Pray for the Prophet ﷺ" reminders (opt-in; default off).
  salawatReminderEnabled  Boolean                @default(false)
  /// Allowed values: 30 | 60 | 120 | 180.
  salawatIntervalMinutes  Int                    @default(180)
  /// Active local window start (HH:mm).
  salawatWindowStart      String                 @default("08:00")
  /// Active local window end (HH:mm). May be overnight vs start.
  salawatWindowEnd        String                 @default("22:00")
  /// Selected catalog clip id (famous listen-link or hosted tone).
  salawatAudioClipId      String                 @default("salli_ala_muhammad_voice")
  /// FCM Surah Al-Mulk bedtime reminder (opt-in; default off). Fires at mulkReminderTime local.
  mulkReminderEnabled     Boolean                @default(false)
  /// Local HH:mm for Surah Al-Mulk reminder (default 20:00).
  mulkReminderTime        String                 @default("20:00")
  /// Personal daily Sadaqah target (EGP). Progress is DailyProgress.sadaqahAmount.
  sadaqahGoal             Decimal                @default(1000) @db.Decimal(10, 2)
  challengeCompletions    ChallengeCompletion[]
  dailyDhikrCompletions   DailyDhikrCompletion[]
  dailyProgress           DailyProgress[]
  deviceTokens            DeviceToken[]
  khatmah                 Khatmah?
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  prayerCompletions       PrayerCompletion[]
  nawafelCompletions      NawafelCompletion[]
  quranBookmarks          QuranBookmark[]
  quranLastRead           QuranLastRead?
  quranReadingHistory     QuranReadingHistory[]
  quranSajdahCompletions  QuranSajdahCompletion[]
  stanceAnswers           StanceAnswer[]
  refreshTokens           RefreshToken[]
  tasbihLogs              TasbihLog[]
  tasbihResetHistory      TasbihResetHistory[]
  userTasbihs             UserTasbih[]
  adhkarFavorites         AdhkarFavorite[]
  adhkarResumeMarks       AdhkarResumeMark[]
  ayahHistory             UserAyahHistory[]
  salawatSendLogs         SalawatSendLog[]
  azanReminderSendLogs    AzanReminderSendLog[]
  mulkSendLogs            MulkSendLog[]

  @@map("users")
}

/// Durable Salawat FCM idempotency (one row per user per occurrence slot).
model SalawatSendLog {
  id             String   @id @default(uuid())
  userId         String
  occurrenceKey  String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, occurrenceKey])
  @@index([userId, createdAt])
  @@map("salawat_send_logs")
}

/// Durable Surah Al-Mulk bedtime FCM idempotency (one row per user per local day+time).
model MulkSendLog {
  id             String   @id @default(uuid())
  userId         String
  occurrenceKey  String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, occurrenceKey])
  @@index([userId, createdAt])
  @@map("mulk_send_logs")
}

/// Durable Azan / Near-Prayer FCM idempotency (one row per user per logical reminder).
/// occurrenceKey includes date + prayer + kind + preReminderMinutes for pre_reminder.
model AzanReminderSendLog {
  id             String   @id @default(uuid())
  userId         String
  occurrenceKey  String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, occurrenceKey])
  @@index([userId, createdAt])
  @@map("azan_reminder_send_logs")
}

/// Blocks login/Google for an identity after Play account deletion.
/// Cleared only when the same email explicitly signs up again (new empty account).
model DeletedIdentity {
  id        String   @id @default(uuid())
  email     String   @unique
  googleId  String?  @unique
  deletedAt DateTime @default(now())

  @@index([googleId])
  @@map("deleted_identities")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String
  platform   String   @default("unknown") // ios | android | web | unknown
  appVersion String?
  locale     String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("device_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model DailyProgress {
  id                       String   @id @default(uuid())
  userId                   String
  date                     DateTime @db.Date
  quranPagesRead           Int      @default(0)
  adhkarCompleted          Boolean  @default(false)
  morningAdhkarCompleted   Boolean  @default(false)
  eveningAdhkarCompleted   Boolean  @default(false)
  sadaqahAmount            Decimal  @default(0) @db.Decimal(10, 2)
  /// Optional per-category totals for today, e.g. { "FOOD": 50, "MONEY": 100 }.
  /// Source of truth for Home/Dashboard remains `sadaqahAmount`.
  sadaqahBreakdown         Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_progress")
}

model PrayerCompletion {
  id          String     @id @default(uuid())
  userId      String
  date        DateTime   @db.Date
  prayer      PrayerName
  completedAt DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, prayer])
  @@index([userId, date])
  @@map("prayer_completions")
}

/// Daily confirmed sunnah rawatib slots (12 rak‘ahs across 5 keys). No FCM in v1.
model NawafelCompletion {
  id          String     @id @default(uuid())
  userId      String
  date        DateTime   @db.Date
  key         NawafelKey
  completedAt DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, key])
  @@index([userId, date])
  @@map("nawafel_completions")
}

model Surah {
  id             Int             @id
  nameEn         String
  nameAr         String
  totalPages     Int             @default(0)
  totalAyahs     Int             @default(0)
  revelationType RevelationType?
  ayahs          Ayah[]
  khatmahs       Khatmah[]
  bookmarks      QuranBookmark[]
  lastReads      QuranLastRead[]
  versesOfTheDay VerseOfTheDay[]

  @@map("surahs")
}

model Ayah {
  id             String            @id @default(uuid())
  surahId        Int
  ayahNumber     Int
  textAr         String
  page           Int?
  juz            Int?
  surah          Surah             @relation(fields: [surahId], references: [id], onDelete: Cascade)
  userAyahHistory UserAyahHistory[]

  @@unique([surahId, ayahNumber])
  @@index([surahId])
  @@map("ayahs")
}

model Khatmah {
  id             String   @id @default(uuid())
  userId         String   @unique
  currentSurahId Int      @default(2)
  currentPage    Int      @default(1)
  totalPagesRead Int      @default(0)
  startedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  currentSurah   Surah    @relation(fields: [currentSurahId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("khatmah")
}

model QuranBookmark {
  id         String   @id @default(uuid())
  userId     String
  surahId    Int
  ayahNumber Int?
  note       String?
  createdAt  DateTime @default(now())
  page       Int?
  surah      Surah    @relation(fields: [surahId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, surahId, ayahNumber])
  @@index([userId, page])
  @@map("quran_bookmarks")
}

model QuranLastRead {
  userId     String   @id
  surahId    Int
  ayahNumber Int
  page       Int?
  updatedAt  DateTime @updatedAt
  surah      Surah    @relation(fields: [surahId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quran_last_read")
}

model QuranReadingHistory {
  id       String   @id @default(uuid())
  userId   String
  surahId  Int
  ayahFrom Int
  ayahTo   Int
  readAt   DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("quran_reading_history")
}

/// Per-user completion of "Ayat as-Sujood" (آيات السجود).
/// There are a canonical fixed set of 15 Sajdah verses across madhhabs;
/// 10 of them are the widely-accepted "Mu'taqidah" (معتقدة عند أهل السنة).
/// Composite PK: (userId, surahId, ayahNumber) → one row max per user per verse.
model QuranSajdahCompletion {
  id          String   @id @default(uuid())
  userId      String
  surahId     Int
  ayahNumber  Int
  /// True = user confirmed "I performed Sujood at-Tilawah when I reached this verse."
  completed   Boolean  @default(false)
  completedAt DateTime?
  /// Which version/recording/reading session triggered this (optional, for analytics).
  sessionId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surahId, ayahNumber])
  @@index([userId])
  @@map("quran_sajdah_completions")
}

model VerseOfTheDay {
  id          String @id @default(uuid())
  dayOfYear   Int    @unique
  surahNumber Int
  ayahNumber  Int
  textAr      String
  referenceAr String
  surah       Surah  @relation(fields: [surahNumber], references: [id])

  @@map("verses_of_the_day")
}

model HadithOfTheDay {
  id        String @id @default(uuid())
  dayOfYear Int    @unique
  textAr    String
  sourceAr  String

  @@map("hadiths_of_the_day")
}

model DailyChallengeTemplate {
  id            String        @id @default(uuid())
  dayOfYear     Int           @unique
  titleAr       String
  titleEn       String?
  descriptionAr String
  descriptionEn String?
  type          ChallengeType
  targetValue   Int
  rewardPoints  Int           @default(50)

  @@map("daily_challenge_templates")
}

model ChallengeCompletion {
  id          String    @id @default(uuid())
  userId      String
  dayOfYear   Int
  completedAt DateTime  @default(now())
  claimedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfYear])
  @@index([userId, dayOfYear])
  @@map("challenge_completions")
}

/// Catalog row for "موقفك إيه؟" (seeded; expandable without Flutter changes).
model StanceSituation {
  id                String         @id
  sortOrder         Int            @unique
  situationAr       String
  situationEn       String?
  optionAAr         String
  optionBAr         String
  optionCAr         String
  correctOptionKey  String
  rulingAr          String
  rulingEn          String?
  /// Citations (Qur'an / Hadith / consensus note) — required for production trust.
  sourceAr          String
  rewardPoints      Int            @default(15)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  answers           StanceAnswer[]

  @@index([isActive, sortOrder])
  @@map("stance_situations")
}

/// User answers for "موقفك إيه؟".
model StanceAnswer {
  id                 String          @id @default(uuid())
  userId             String
  situationId        String
  selectedOptionKey  String
  isCorrect          Boolean
  pointsAwarded      Int             @default(0)
  answeredAt         DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  situation          StanceSituation @relation(fields: [situationId], references: [id], onDelete: Cascade)

  @@unique([userId, situationId])
  @@index([userId, answeredAt])
  @@map("stance_answers")
}

model TasbihLog {
  id           String               @id @default(uuid())
  userId       String
  date         DateTime             @db.Date
  dhikr        TasbihDhikr          @default(ALHAMDULILLAH)
  count        Int                  @default(0)
  totalAllTime Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resetHistory TasbihResetHistory[]

  @@unique([userId, date])
  @@index([userId, date])
  @@map("tasbih_logs")
}

model TasbihResetHistory {
  id               String    @id @default(uuid())
  userId           String
  tasbihLogId      String
  countBeforeReset Int
  date             DateTime  @default(now())
  tasbihLog        TasbihLog @relation(fields: [tasbihLogId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("tasbih_reset_history")
}

/// Per-user custom tasbih / dhikr phrases for the personal picker list.
model UserTasbih {
  id        String   @id @default(uuid())
  userId    String
  text      String
  /// Optional target repetition; null = open-ended.
  count     Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, text])
  @@index([userId, sortOrder])
  @@map("user_tasbihs")
}

model DhikrCategory {
  id            String                 @id @default(uuid())
  key           DhikrCategoryKey       @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  iconCode      String
  sortOrder     Int                    @default(0)
  totalItems    Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  completions   DailyDhikrCompletion[]
  items         DhikrItem[]

  @@index([sortOrder])
  @@map("dhikr_categories")
}

model DhikrItem {
  id              String        @id @default(uuid())
  categoryId      String
  orderInCategory Int           @default(0)
  textAr          String
  textEn          String?
  textArPlain     String?
  repeatCount     Int           @default(1)
  referenceAr     String?
  referenceEn     String?
  sourceUrl       String?
  benefitAr       String?
  benefitEn       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category    DhikrCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  completions DailyDhikrCompletion[]
  favorites   AdhkarFavorite[]

  @@index([categoryId, orderInCategory])
  @@map("dhikr_items")
}

model DailyDhikrCompletion {
  id         String         @id @default(uuid())
  userId     String
  date       DateTime       @db.Date
  categoryId String?
  itemId     String?
  countDone  Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category DhikrCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  item     DhikrItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([userId, date, categoryId, itemId])
  @@index([userId, date])
  @@map("daily_dhikr_completions")
}

model AdhkarFavorite {
  id        String    @id @default(uuid())
  userId    String
  itemId    String
  createdAt DateTime  @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item DhikrItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("adhkar_favorites")
}

model AdhkarResumeMark {
  id           String   @id @default(uuid())
  userId       String
  categoryKey  String
  markedItemId String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryKey])
  @@index([userId, categoryKey])
  @@map("adhkar_resume_marks")
}

model UserAyahHistory {
  id          String   @id @default(uuid())
  userId      String
  sessionId   String   @db.Uuid
  surahId     Int
  ayahNumber  Int
  displayDate DateTime @db.Date
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ayah Ayah  @relation(fields: [surahId, ayahNumber], references: [surahId, ayahNumber], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("user_ayah_history")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  titleAr   String
  titleEn   String
  bodyAr    String
  bodyEn    String
  type      NotificationType @default(SYSTEM)
  readAt    DateTime?
  deepLink  String?
  payload   Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserRole {
  USER
  ADMIN
}

enum PrayerName {
  FAJR
  DHUHR
  ASR
  MAGHRIB
  ISHA
}

enum ChallengeType {
  QURAN_PAGES
  PRAYER
  PRAYERS_ALL
  ADHKAR
  SADAQAH
}

enum RevelationType {
  MAKKI
  MADANI
}

enum TasbihDhikr {
  SUBHAN_ALLAH
  ALHAMDULILLAH
  LA_ILAHA_ILLA_ALLAH
  ALLAHU_AKBAR
  ASTAGHFIRULLAH
  LA_HAWLA_WA_LA_QUWWATA_ILLA_BILLAH
  SUBHAN_ALLAHI_WA_BIHAMDIHI
  LA_ILAHA_ILLA_ALLAH_WAHDAHU
  SUBHAN_ALLAHI_WA_BIHAMDIHI_SUBHAN_ALLAHI_L_AZIM
}

enum DhikrCategoryKey {
  MORNING
  EVENING
  BEFORE_SLEEP
  ENTERING_MOSQUE
  AFTER_PRAYER
  GENERAL_WIRD
  TRAVEL
  SICK
  FOOD
  ISTIKHARA
  WUDU
  ISTIGHFAR
  QAYN
  MASJID_AFTER_SALAM
}

enum NotificationType {
  SYSTEM
  AZAN
  CHALLENGE
  PRAYER_REMINDER
  ACHIEVEMENT
  GENERAL
  SALAWAT
  MULK
}

/// Classic daily rawatib (12 rak‘ahs) — one checklist row per slot.
enum NawafelKey {
  FAJR_BEFORE_2
  DHUHR_BEFORE_4
  DHUHR_AFTER_2
  MAGHRIB_AFTER_2
  ISHA_AFTER_2
}
