generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserRole {
  USER
  ADMIN
}

enum PrayerName {
  FAJR
  DHUHR
  ASR
  MAGHRIB
  ISHA
}

enum ChallengeType {
  QURAN_PAGES
  PRAYER
  ADHKAR
  SADAQAH
}

enum RevelationType {
  MAKKI
  MADANI
}


model User {
  id              String       @id @default(uuid())
  username        String       @unique
  fullName        String?
  email           String       @unique
  password        String?
  provider        AuthProvider @default(LOCAL)
  providerId      String?
  googleId        String?      @unique
  role            UserRole     @default(USER)
  isActive        Boolean      @default(true)
  points          Int          @default(0)
  timezone        String       @default("Africa/Cairo")
  latitude        Float?
  longitude       Float?
  quranFontSize   Int          @default(28)
  quranReciter    String       @default("Mishary_Alafasy")
  quranTafsir     String       @default("Ibn_Kathir")
  quranTranslation String      @default("Sahih_International")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  dailyProgress        DailyProgress[]
  prayerCompletions    PrayerCompletion[]
  khatmah              Khatmah?
  challengeCompletions ChallengeCompletion[]
  quranBookmarks       QuranBookmark[]
  quranLastRead        QuranLastRead?
  quranReadingHistory  QuranReadingHistory[]
  tasbihLogs           TasbihLog[]
  tasbihResetHistory   TasbihResetHistory[]
  notifications        Notification[]
  dailyDhikrCompletions DailyDhikrCompletion[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model DailyProgress {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @db.Date
  quranPagesRead  Int      @default(0)
  adhkarCompleted Boolean  @default(false)
  sadaqahAmount   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_progress")
}

model PrayerCompletion {
  id          String     @id @default(uuid())
  userId      String
  date        DateTime   @db.Date
  prayer      PrayerName
  completedAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, prayer])
  @@index([userId, date])
  @@map("prayer_completions")
}

model Surah {
  id              Int             @id
  nameEn          String
  nameAr          String
  totalAyahs      Int             @default(0)
  totalPages      Int             @default(0)
  revelationType  RevelationType?

  ayahs          Ayah[]
  khatmahs       Khatmah[]
  versesOfTheDay VerseOfTheDay[]
  bookmarks      QuranBookmark[]
  lastReads      QuranLastRead[]

  @@map("surahs")
}

model Ayah {
  id         String @id @default(uuid())
  surahId    Int
  ayahNumber Int
  textAr     String @db.Text
  page       Int?
  juz        Int?

  surah Surah @relation(fields: [surahId], references: [id], onDelete: Cascade)

  @@unique([surahId, ayahNumber])
  @@index([surahId])
  @@map("ayahs")
}

model Khatmah {
  id             String   @id @default(uuid())
  userId         String   @unique
  currentSurahId Int      @default(2)
  currentPage    Int      @default(1)
  totalPagesRead Int      @default(0)
  startedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSurah Surah @relation(fields: [currentSurahId], references: [id])

  @@map("khatmah")
}

model QuranBookmark {
  id         String   @id @default(uuid())
  userId     String
  surahId    Int
  ayahNumber Int?
  page       Int?
  note       String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  surah Surah @relation(fields: [surahId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, surahId, ayahNumber])
  @@index([userId, page])
  @@map("quran_bookmarks")
}

model QuranLastRead {
  userId     String   @id
  surahId    Int
  ayahNumber Int
  page       Int?
  updatedAt  DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  surah Surah @relation(fields: [surahId], references: [id])

  @@map("quran_last_read")
}

model QuranReadingHistory {
  id       String   @id @default(uuid())
  userId   String
  surahId  Int
  ayahFrom Int
  ayahTo   Int
  readAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("quran_reading_history")
}

model VerseOfTheDay {
  id          String @id @default(uuid())
  dayOfYear   Int    @unique
  surahNumber Int
  ayahNumber  Int
  textAr      String
  referenceAr String

  surah Surah @relation(fields: [surahNumber], references: [id])

  @@map("verses_of_the_day")
}

model HadithOfTheDay {
  id        String @id @default(uuid())
  dayOfYear Int    @unique
  textAr    String
  sourceAr  String

  @@map("hadiths_of_the_day")
}

model DailyChallengeTemplate {
  id            String        @id @default(uuid())
  dayOfYear     Int           @unique
  titleAr       String
  descriptionAr String
  type          ChallengeType
  targetValue   Int
  rewardPoints  Int           @default(50)

  @@map("daily_challenge_templates")
}

model ChallengeCompletion {
  id          String    @id @default(uuid())
  userId      String
  dayOfYear   Int
  completedAt DateTime  @default(now())
  claimedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfYear])
  @@index([userId, dayOfYear])
  @@map("challenge_completions")
}

enum TasbihDhikr {
  SUBHAN_ALLAH
  ALHAMDULILLAH
  LA_ILAHA_ILLA_ALLAH
  ALLAHU_AKBAR
  ASTAGHFIRULLAH
  LA_HAWLA_WA_LA_QUWWATA_ILLA_BILLAH
}

model TasbihLog {
  id           String      @id @default(uuid())
  userId       String
  date         DateTime    @db.Date
  dhikr        TasbihDhikr @default(ALHAMDULILLAH)
  count        Int         @default(0)
  totalAllTime Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resetHistory TasbihResetHistory[]

  @@unique([userId, date])
  @@index([userId, date])
  @@map("tasbih_logs")
}

model TasbihResetHistory {
  id                String   @id @default(uuid())
  userId            String
  tasbihLogId       String
  countBeforeReset  Int
  date              DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasbihLog  TasbihLog  @relation(fields: [tasbihLogId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("tasbih_reset_history")
}

// ============================================================
//  Adhkar / Hisnul Muslim Module (Morning, Evening, Sleep, Mosque, Prayer, Salat)
//  Source: Fortress of the Muslim (حصن المسلم) — Authentic verified collection
// ============================================================

enum DhikrCategoryKey {
  MORNING             // اذكار الصباح
  EVENING             // اذكار المساء
  BEFORE_SLEEP        // اذكار النوم
  ENTERING_MOSQUE     // اذكار المسجد
  AFTER_PRAYER        // اذكار الصلاة (after fard salah)
  GENERAL_WIRD        // اذكار متنوعة / ورد يومي إضافي
}

model DhikrCategory {
  id            String        @id @default(uuid())
  key           DhikrCategoryKey @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  iconCode      String        // e.g. "☀️" (just a UTF-8 emoji string; Flutter renders it inline)
  sortOrder     Int           @default(0)
  totalItems    Int           @default(0) // cache for the count of DhikrItem[] below
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items DhikrItem[]
  completions DailyDhikrCompletion[]

  @@index([sortOrder])
  @@map("dhikr_categories")
}

model DhikrItem {
  id              String        @id @default(uuid())
  categoryId      String
  orderInCategory Int           @default(0)
  textAr          String        // the full dhikr / dua text in Arabic, full diacritics
  textArPlain     String?       // optional — same text without diacritics, useful for search
  repeatCount     Int           @default(1)  // "التكرار 3" from the detail screen card footer
  referenceAr     String?       // e.g. "رواه البخاري ومسلم"
  referenceEn     String?
  sourceUrl       String?       // optional hotlink to Sunnah.com / IslamQA proof
  benefitAr       String?       // optional short fadhilah / فضل الذكر
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category    DhikrCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  completions DailyDhikrCompletion[]

  @@index([categoryId, orderInCategory])
  @@map("dhikr_items")
}

model DailyDhikrCompletion {
  id         String   @id @default(uuid())
  userId     String
  date       DateTime @db.Date
  categoryId String?  // nullable — when null it means a "single-item standalone" mark
  itemId     String?  // nullable — when set, it's a per-dhikr-item check
  countDone  Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category DhikrCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  item     DhikrItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([userId, date, categoryId, itemId])
  @@index([userId, date])
  @@map("daily_dhikr_completions")
}

enum NotificationType {
  PRAYER_REMINDER
  CHALLENGE
  ACHIEVEMENT
  GENERAL
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  titleAr   String
  bodyAr    String
  type      NotificationType @default(GENERAL)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}
