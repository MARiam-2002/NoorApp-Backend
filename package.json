{
  "name": "noor-api",
  "version": "1.0.0",
  "description": "Noor - Islamic Lifestyle REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-hadith-bank.cjs",
    "postinstall": "prisma generate --no-hints && node scripts/patch-adhan.cjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:account-delete": "tsx scripts/smoke-account-delete.ts",
    "test:account-delete-db": "tsx scripts/verify-account-delete-db.ts",
    "test:play-launch": "tsx scripts/verify-play-launch-prod.ts",
    "test:production-fixes": "tsx scripts/verify-production-fixes.ts",
    "test:phase1-perf": "tsx scripts/verify-phase1-perf.ts",
    "test:salawat": "tsx scripts/test-salawat-eligibility.ts && tsx scripts/test-salawat-audio.ts",
    "test:salawat-db": "tsx scripts/test-salawat-db.ts",
    "test:salawat-http": "tsx scripts/test-salawat-http.ts",
    "test:mulk": "tsx scripts/test-mulk-eligibility.ts",
    "smoke:mulk": "tsx scripts/smoke-mulk-production.ts",
    "test:sadaqah-goal": "tsx scripts/test-sadaqah-goal.ts",
    "test:sadaqah-goal-http": "tsx scripts/test-sadaqah-goal-http.ts",
    "test:cleanup-no-fcm": "tsx scripts/test-cleanup-users-without-fcm.ts",
    "cleanup:users-without-fcm": "tsx scripts/cleanup-users-without-fcm.ts",
    "test:near-prayer": "tsx scripts/test-near-prayer-resolver.ts && tsx scripts/test-near-prayer-audit.ts",
    "test": "npm run test:production-fixes && npm run test:phase1-perf && npm run test:salawat && npm run test:mulk && npm run test:sadaqah-goal && npm run test:near-prayer && npm run test:cleanup-no-fcm",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "rest-api",
    "islamic"
  ],
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "adhan": "^4.4.4",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "firebase-admin": "^13.10.0",
    "glob": "^11.0.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "nodemailer": "^6.9.16",
    "prisma": "^6.19.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-dist": "^5.17.14",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "tz-lookup": "^6.1.25",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  }
}
